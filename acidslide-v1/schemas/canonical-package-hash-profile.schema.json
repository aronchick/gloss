{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acidslide.dev/schemas/canonical-package-hash-profile.schema.json",
  "title": "AcidSlide Canonical Package Hash Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "digest",
    "framing",
    "entry_policy",
    "content_type_policy",
    "xml_policy",
    "stage_0_5_resolution",
    "relationship_policy",
    "reachability_policy",
    "volatile_xml"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_id": { "const": "acidslide-canonical-package-hash-v1" },
    "digest": { "const": "sha256" },
    "framing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_separator_utf8", "name_length", "content_length", "integer_byte_order"],
      "properties": {
        "domain_separator_utf8": { "const": "AcidSlide canonical package hash v1\u0000" },
        "name_length": { "const": "uint32" },
        "content_length": { "const": "uint64" },
        "integer_byte_order": { "const": "big" }
      }
    },
    "entry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "directory_entries", "duplicate_names", "unsafe_names", "encrypted_entries"],
      "properties": {
        "order": { "const": "utf8_lexicographic_part_name" },
        "directory_entries": { "const": "ignore" },
        "duplicate_names": { "const": "error" },
        "unsafe_names": { "const": "error" },
        "encrypted_entries": { "const": "error" }
      }
    },
    "content_type_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration", "unknown", "accepted"],
      "properties": {
        "declaration": { "const": "required_for_every_non_relationship_part" },
        "unknown": { "const": "error" },
        "accepted": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^/]+/[^/]+$" }
        }
      }
    },
    "xml_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "comments", "dtd", "external_entities", "binary_parts"],
      "properties": {
        "canonicalization": { "const": "c14n-1.0-inclusive" },
        "comments": { "const": "remove" },
        "dtd": { "const": "error" },
        "external_entities": { "const": "error" },
        "binary_parts": { "const": "raw_uncompressed_bytes" }
      }
    },
    "stage_0_5_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mce_profile",
        "schema_root_map",
        "relevant_part_prefix",
        "unmapped_relevant_xml"
      ],
      "properties": {
        "mce_profile": { "const": "mce-profile-v1.json" },
        "schema_root_map": { "const": "schema-root-map-v1.json" },
        "relevant_part_prefix": { "const": "ppt/" },
        "unmapped_relevant_xml": { "const": "error" }
      }
    },
    "relationship_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_type", "sort", "target_resolution", "relationship_id", "external_targets"],
      "properties": {
        "content_type": { "const": "application/vnd.openxmlformats-package.relationships+xml" },
        "sort": { "const": "relationship_id_utf8" },
        "target_resolution": { "const": "opc_rfc3986_absolute_part_name" },
        "relationship_id": { "const": "preserve" },
        "external_targets": { "const": "error" }
      }
    },
    "reachability_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_relationship_part", "office_document_relationship_type", "orphan_parts"],
      "properties": {
        "root_relationship_part": { "const": "_rels/.rels" },
        "office_document_relationship_type": {
          "const": "http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument"
        },
        "orphan_parts": { "const": "error" }
      }
    },
    "volatile_xml": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_name", "required_root_qname", "canonicalization", "strip_text_qnames", "strip_attribute_qnames"],
      "properties": {
        "part_name": { "const": "docProps/core.xml" },
        "required_root_qname": {
          "const": "{http://schemas.openxmlformats.org/package/2006/metadata/core-properties}coreProperties"
        },
        "canonicalization": { "const": "c14n-1.0-without-comments" },
        "strip_text_qnames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\{https?://[^}]+\\}[^{}]+$" }
        },
        "strip_attribute_qnames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\{https?://[^}]+\\}[^{}]+$" }
        }
      }
    }
  }
}
