{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acidslide.dev/schemas/release-keys.schema.json",
  "title": "AcidSlide Authorized Release Keys",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "algorithm",
          "public_key_base64",
          "valid_from",
          "valid_until",
          "revoked_at"
        ],
        "properties": {
          "key_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
          "algorithm": { "const": "Ed25519" },
          "public_key_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" },
          "valid_from": { "type": "string", "format": "date-time" },
          "valid_until": {
            "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }]
          },
          "revoked_at": {
            "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }]
          }
        }
      }
    }
  }
}
