{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acidslide.dev/schemas/report-semantic-projection.schema.json",
  "title": "AcidSlide Score-Semantic Report Projection",
  "description": "The only cross-build score equality surface. Unknown, diagnostic, identity, timing, provenance, environment, seed, attestation, and hash fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection_schema_version",
    "run_kind",
    "grading_mode",
    "targeted_tier",
    "prompt_variant",
    "schema_validation_performed",
    "schema_valid",
    "visual_verification_performed",
    "verification_complete",
    "scoring_completed",
    "eligible",
    "disqualification_state",
    "ineligibility_reasons",
    "repair_triggered",
    "gold_duplicate_check",
    "fidelity_score",
    "campaign_contribution",
    "passed_items",
    "total_items",
    "tier_scores",
    "slides",
    "deck_items",
    "anti_cheat_flags",
    "schema_errors",
    "verification_errors"
  ],
  "properties": {
    "projection_schema_version": { "const": "1.0" },
    "run_kind": { "enum": ["submission", "reference_control", "baseline_control"] },
    "grading_mode": { "enum": ["local", "hosted"] },
    "targeted_tier": { "type": "integer", "enum": [1, 2, 3] },
    "prompt_variant": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "schema_validation_performed": { "type": "boolean" },
    "schema_valid": { "type": "boolean" },
    "visual_verification_performed": { "type": "boolean" },
    "verification_complete": { "type": "boolean" },
    "scoring_completed": { "type": "boolean" },
    "eligible": { "type": "boolean" },
    "disqualification_state": { "enum": ["none", "completed_ineligible", "non_official_local"] },
    "ineligibility_reasons": { "$ref": "#/$defs/stable_codes" },
    "repair_triggered": { "type": "boolean" },
    "gold_duplicate_check": { "enum": ["clear", "byte_match", "canonical_match", "incomplete"] },
    "fidelity_score": { "$ref": "#/$defs/score_or_null" },
    "campaign_contribution": { "$ref": "#/$defs/score" },
    "passed_items": { "type": "integer", "minimum": 0 },
    "total_items": { "type": "integer", "minimum": 0 },
    "tier_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level_1", "level_2", "level_3"],
      "properties": {
        "level_1": { "$ref": "#/$defs/tier_score_or_null" },
        "level_2": { "$ref": "#/$defs/tier_score_or_null" },
        "level_3": { "$ref": "#/$defs/tier_score_or_null" }
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slide", "tier", "passed_items", "total_items", "items"],
        "properties": {
          "slide": { "type": "integer", "minimum": 1, "maximum": 20 },
          "tier": { "type": "integer", "enum": [1, 2, 3] },
          "passed_items": { "type": "integer", "minimum": 0 },
          "total_items": { "type": "integer", "minimum": 0 },
          "items": { "type": "array", "items": { "$ref": "#/$defs/item_outcome" } }
        }
      }
    },
    "deck_items": { "type": "array", "items": { "$ref": "#/$defs/item_outcome" } },
    "anti_cheat_flags": { "type": "array", "items": { "$ref": "#/$defs/anti_cheat_outcome" } },
    "schema_errors": { "type": "array", "items": { "$ref": "#/$defs/stable_error" } },
    "verification_errors": { "type": "array", "items": { "$ref": "#/$defs/stable_error" } }
  },
  "allOf": [
    {
      "if": { "properties": { "scoring_completed": { "const": false } }, "required": ["scoring_completed"] },
      "then": {
        "properties": {
          "fidelity_score": { "type": "null" },
          "campaign_contribution": { "const": 0.0 },
          "eligible": { "const": false },
          "tier_scores": { "properties": { "level_1": { "type": "null" }, "level_2": { "type": "null" }, "level_3": { "type": "null" } } }
        }
      },
      "else": { "properties": { "fidelity_score": { "$ref": "#/$defs/score" } } }
    },
    {
      "if": { "properties": { "verification_complete": { "const": true } }, "required": ["verification_complete"] },
      "then": { "properties": { "scoring_completed": { "const": true } } }
    },
    {
      "if": { "properties": { "eligible": { "const": true } }, "required": ["eligible"] },
      "then": {
        "properties": {
          "run_kind": { "const": "submission" },
          "grading_mode": { "const": "hosted" },
          "scoring_completed": { "const": true },
          "verification_complete": { "const": true },
          "schema_validation_performed": { "const": true },
          "schema_valid": { "const": true },
          "visual_verification_performed": { "const": true },
          "repair_triggered": { "const": false },
          "gold_duplicate_check": { "const": "clear" },
          "disqualification_state": { "const": "none" },
          "ineligibility_reasons": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "run_kind": { "const": "submission" }, "grading_mode": { "const": "local" } }, "required": ["run_kind", "grading_mode"] },
      "then": {
        "properties": {
          "eligible": { "const": false },
          "campaign_contribution": { "const": 0.0 },
          "disqualification_state": { "const": "non_official_local" },
          "ineligibility_reasons": { "const": ["local_mode"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_kind": { "const": "submission" },
          "grading_mode": { "const": "hosted" },
          "scoring_completed": { "const": true },
          "verification_complete": { "const": true },
          "schema_validation_performed": { "const": true },
          "schema_valid": { "const": true },
          "visual_verification_performed": { "const": true },
          "repair_triggered": { "const": false },
          "gold_duplicate_check": { "const": "clear" },
          "disqualification_state": { "const": "none" },
          "ineligibility_reasons": { "maxItems": 0 }
        },
        "required": ["run_kind", "grading_mode", "scoring_completed", "verification_complete", "schema_validation_performed", "schema_valid", "visual_verification_performed", "repair_triggered", "gold_duplicate_check", "disqualification_state", "ineligibility_reasons"]
      },
      "then": { "properties": { "eligible": { "const": true } } }
    },
    {
      "if": { "properties": { "eligible": { "const": false } }, "required": ["eligible"] },
      "then": { "properties": { "campaign_contribution": { "const": 0.0 } } }
    },
    {
      "if": { "properties": { "repair_triggered": { "const": true } }, "required": ["repair_triggered"] },
      "then": {
        "properties": {
          "verification_complete": { "const": false },
          "eligible": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_kind": { "const": "submission" },
          "gold_duplicate_check": { "enum": ["byte_match", "canonical_match", "incomplete"] }
        },
        "required": ["run_kind", "gold_duplicate_check"]
      },
      "then": {
        "properties": {
          "verification_complete": { "const": false },
          "scoring_completed": { "const": false },
          "eligible": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "disqualification_state": { "const": "none" } }, "required": ["disqualification_state"] },
      "then": { "properties": { "ineligibility_reasons": { "maxItems": 0 } } },
      "else": { "properties": { "ineligibility_reasons": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "score_or_null": { "oneOf": [{ "$ref": "#/$defs/score" }, { "type": "null" }] },
    "stable_code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$" },
    "stable_codes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stable_code" } },
    "slide_numbers": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 20 } },
    "tier_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fidelity_score", "passed", "total"],
      "properties": {
        "fidelity_score": { "$ref": "#/$defs/score" },
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "tier_score_or_null": { "oneOf": [{ "$ref": "#/$defs/tier_score" }, { "type": "null" }] },
    "item_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assertion_id", "passed", "severity", "weight", "outcome_code", "tier_affected_slides"],
      "properties": {
        "id": { "type": "string", "pattern": "^(slide-\\d{2}|deck)\\.[a-z0-9][a-z0-9.-]*$" },
        "assertion_id": { "type": "string", "pattern": "^(slide-\\d{2}|deck)\\.assert-[a-z0-9][a-z0-9.-]*$" },
        "passed": { "type": "boolean" },
        "severity": { "enum": ["critical", "major", "minor", "informational"] },
        "weight": { "type": "integer", "enum": [0, 1, 2, 3] },
        "outcome_code": { "$ref": "#/$defs/stable_code" },
        "tier_affected_slides": { "$ref": "#/$defs/slide_numbers" }
      }
    },
    "anti_cheat_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "disposition", "affected_slides", "tier_affected_slides"],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
        "disposition": { "enum": ["warning", "zero_slide", "zero_affected_slides", "reject"] },
        "affected_slides": { "$ref": "#/$defs/slide_numbers" },
        "tier_affected_slides": { "$ref": "#/$defs/slide_numbers" }
      }
    },
    "stable_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "part", "location"],
      "properties": {
        "code": { "$ref": "#/$defs/stable_code" },
        "part": { "type": ["string", "null"] },
        "location": { "type": ["string", "null"] }
      }
    }
  }
}
