{
  "schema_version": "1.0",
  "profile_id": "acidslide-scene-graph-profile-v1",
  "input_contract": {
    "package_state": "mce-resolved",
    "allowed_slide_counts": [5, 12, 20],
    "mce_namespace_policy": "reject-elements-and-attributes",
    "external_relationship_policy": "reject",
    "dangling_relationship_policy": "reject",
    "missing_layout_or_master_policy": "reject"
  },
  "slide_order": {
    "source_part": "/ppt/presentation.xml",
    "id_path": "/p:presentation/p:sldIdLst/p:sldId/@r:id",
    "relationship_part": "/ppt/_rels/presentation.xml.rels"
  },
  "relationship_normalization": {
    "internal_target_form": "absolute-opc-part-name",
    "external_target_form": "prohibited",
    "order": "relationship-id-unicode-codepoint",
    "duplicate_id_policy": "reject"
  },
  "node_normalization": {
    "source_order": "shape-tree-document-order",
    "node_id": "slide-number-and-zero-based-structural-index-path",
    "ignored_identifiers": ["p:cNvPr/@id", "p:cNvPr/@name"],
    "bbox_coordinate_space": "owning-shape-tree-emu",
    "kind_precedence": [
      "group",
      "connector",
      "table",
      "chart",
      "picture",
      "placeholder",
      "field",
      "text",
      "shape",
      "graphic_frame"
    ]
  },
  "text_normalization": {
    "run_sources": ["a:r", "a:fld", "a:br"],
    "break_text": "\n",
    "font_resolution": "direct-run-properties-only",
    "missing_boolean": null,
    "missing_language_or_font": null
  },
  "numeric_normalization": {
    "geometry_unit": "EMU",
    "rotation_source_unit": "60000th-degree",
    "rotation_output": "exact-decimal-no-trailing-zero",
    "font_size_source_unit": "100th-point",
    "font_size_output": "exact-decimal-no-trailing-zero",
    "opacity_source_unit": "100000th",
    "opacity_output": "exact-decimal-no-trailing-zero"
  },
  "serialization": {
    "canonicalization": "RFC8785-JCS",
    "deck_fixture": "expected-deck.json",
    "slide_fixture_pattern": "expected-scenegraphs/slide-%02d.json",
    "slide_order": "ascending-slide-number",
    "node_order": "z-index",
    "relationship_order": "relationship-id-unicode-codepoint"
  }
}
