{
  "schema_version": "1.0",
  "profile_id": "acidslide-ssim-profile-v1",
  "algorithm": "skimage.metrics.structural_similarity",
  "threshold": 0.9999,
  "dtype": "uint8",
  "shape": [1080, 1920, 3],
  "channel_axis": 2,
  "data_range": 255,
  "win_size": 7,
  "gaussian_weights": false,
  "use_sample_covariance": true,
  "K1": 0.01,
  "K2": 0.03,
  "dimension_mismatch": "fail-with-zero-similarity",
  "pixel_exact": "numpy.array_equal"
}
