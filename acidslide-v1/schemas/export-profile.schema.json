{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acidslide.dev/schemas/export-profile.schema.json",
  "title": "AcidSlide v1 PPTX to PDF Export Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "platform",
    "pipeline",
    "execution_wrapper",
    "libreoffice_command",
    "fresh_isolated_user_profile_per_export",
    "presentation_size_emu",
    "allowed_page_counts",
    "reference_datetime",
    "pdf_page_geometry",
    "renderer_diagnostics",
    "failure_policy"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_id": { "const": "acidslide-export-profile-v1" },
    "platform": { "const": "linux/amd64" },
    "pipeline": { "const": "pptx_to_pdf_to_poppler_png" },
    "execution_wrapper": { "const": "libfaketime_preload_all_subprocesses" },
    "libreoffice_command": {
      "const": [
        "libreoffice",
        "--headless",
        "-env:UserInstallation=file://<isolated-temporary-profile>",
        "--convert-to",
        "pdf",
        "--outdir",
        "/work",
        "/input/submission.pptx"
      ]
    },
    "fresh_isolated_user_profile_per_export": { "const": true },
    "presentation_size_emu": { "const": { "cx": 12192000, "cy": 6858000 } },
    "allowed_page_counts": { "const": [5, 12, 20] },
    "reference_datetime": { "const": "2025-01-01T00:00:00Z" },
    "pdf_page_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numeric_parser", "media_box", "crop_box", "rotate"],
      "properties": {
        "numeric_parser": { "const": "exact-decimal-string" },
        "media_box": { "const": ["0", "0", "960.009448818898", "540"] },
        "crop_box": { "const": "absent-or-exactly-equal-to-media-box" },
        "rotate": { "const": "absent-or-zero" }
      }
    },
    "renderer_diagnostics": {
      "const": {
        "stdout": "informational",
        "stderr": "reject-except-exact-allowlist",
        "allowed_stderr_lines": [
          "Warning: failed to launch javaldx - java may not function correctly"
        ]
      }
    },
    "failure_policy": {
      "const": {
        "direct_png_export": "reject",
        "alternate_rasterizer": "reject",
        "page_count_mismatch": "reject",
        "page_geometry_mismatch": "reject",
        "renderer_warning_unclassified": "reject",
        "resize_fallback": "reject"
      }
    }
  }
}
