{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acidslide.dev/schemas/export-determinism-evidence.schema.json",
  "title": "AcidSlide 100-Run Gold Export Determinism Evidence",
  "description": "RFC 8785-canonicalized release evidence for all 4,950 unordered pairs of 100 canonical 20-page gold exports. The evidence contains no self-hash; the signed scoring manifest binds its JCS SHA-256.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "benchmark_version",
    "canonicalization",
    "measured_at",
    "bindings",
    "run_count",
    "page_count",
    "run_pair_count",
    "page_pair_comparison_count",
    "required_minimum_ssim",
    "canonical_run",
    "runs",
    "run_pairs",
    "minimum_ssim_by_page",
    "global_minimum_ssim"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "evidence_id": { "const": "acidslide-export-determinism-evidence-v1" },
    "benchmark_version": { "const": "acidslide-v1.0.0" },
    "canonicalization": { "const": "RFC8785-JCS" },
    "measured_at": { "type": "string", "format": "date-time" },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_attestation_sha256",
        "original_gold_sha256",
        "resolved_gold_sha256",
        "canonical_package_hash_profile_sha256",
        "canonical_package_hash_v1",
        "canonical_pdf_sha256",
        "canonical_png_sha256s",
        "export_profile_sha256",
        "ssim_profile_sha256"
      ],
      "properties": {
        "environment_attestation_sha256": { "$ref": "#/$defs/hash" },
        "original_gold_sha256": { "$ref": "#/$defs/hash" },
        "resolved_gold_sha256": { "$ref": "#/$defs/hash" },
        "canonical_package_hash_profile_sha256": { "$ref": "#/$defs/hash" },
        "canonical_package_hash_v1": { "$ref": "#/$defs/hash" },
        "canonical_pdf_sha256": { "$ref": "#/$defs/hash" },
        "canonical_png_sha256s": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/hash" }
        },
        "export_profile_sha256": { "$ref": "#/$defs/hash" },
        "ssim_profile_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "run_count": { "const": 100 },
    "page_count": { "const": 20 },
    "run_pair_count": { "const": 4950 },
    "page_pair_comparison_count": { "const": 99000 },
    "required_minimum_ssim": { "const": 0.99999 },
    "canonical_run": { "const": 1 },
    "runs": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/run" }
    },
    "run_pairs": {
      "type": "array",
      "minItems": 4950,
      "maxItems": 4950,
      "items": { "$ref": "#/$defs/run_pair" }
    },
    "minimum_ssim_by_page": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "minimum_ssim"],
        "properties": {
          "page": { "$ref": "#/$defs/page_number" },
          "minimum_ssim": { "$ref": "#/$defs/ssim" }
        }
      }
    },
    "global_minimum_ssim": { "$ref": "#/$defs/ssim" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "page_number": { "type": "integer", "minimum": 1, "maximum": 20 },
    "run_number": { "type": "integer", "minimum": 1, "maximum": 100 },
    "ssim": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "pdf_sha256", "export_bundle_sha256", "pages"],
      "properties": {
        "run": { "$ref": "#/$defs/run_number" },
        "pdf_sha256": { "$ref": "#/$defs/hash" },
        "export_bundle_sha256": { "$ref": "#/$defs/hash" },
        "pages": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page", "png_sha256"],
            "properties": {
              "page": { "$ref": "#/$defs/page_number" },
              "png_sha256": { "$ref": "#/$defs/hash" }
            }
          }
        }
      }
    },
    "run_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_a", "run_b", "page_comparisons", "minimum_ssim"],
      "properties": {
        "run_a": { "$ref": "#/$defs/run_number" },
        "run_b": { "$ref": "#/$defs/run_number" },
        "page_comparisons": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page", "ssim"],
            "properties": {
              "page": { "$ref": "#/$defs/page_number" },
              "ssim": { "$ref": "#/$defs/ssim" }
            }
          }
        },
        "minimum_ssim": { "$ref": "#/$defs/ssim" }
      }
    }
  }
}
