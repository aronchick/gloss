{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acidslide.dev/schemas/scoring-manifest.schema.json",
  "title": "AcidSlide v1 Frozen Scoring Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "release_status",
    "benchmark_version",
    "platform",
    "oci_image_digest",
    "runtime",
    "render_profiles",
    "export",
    "visual_comparison",
    "structural_profiles",
    "artifacts",
    "gold"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "manifest_id": { "const": "acidslide-scoring-manifest-v1" },
    "release_status": { "const": "frozen" },
    "benchmark_version": { "type": "string", "pattern": "^acidslide-v1\\.0\\.0$" },
    "platform": { "const": "linux/amd64" },
    "oci_image_digest": { "$ref": "#/$defs/prefixed_sha256" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "libreoffice",
        "poppler",
        "python",
        "pillow",
        "numpy",
        "scikit_image",
        "lxml",
        "grader",
        "libfaketime",
        "fontconfig",
        "libfaketime_library_sha256",
        "fontconfig_config_sha256",
        "locale",
        "timezone",
        "reference_datetime",
        "faketime_environment",
        "environment_attestation_sha256"
      ],
      "properties": {
        "libreoffice": { "$ref": "#/$defs/nonempty" },
        "poppler": { "$ref": "#/$defs/nonempty" },
        "python": { "$ref": "#/$defs/nonempty" },
        "pillow": { "$ref": "#/$defs/nonempty" },
        "numpy": { "$ref": "#/$defs/nonempty" },
        "scikit_image": { "$ref": "#/$defs/nonempty" },
        "lxml": { "$ref": "#/$defs/nonempty" },
        "grader": { "$ref": "#/$defs/nonempty" },
        "libfaketime": { "$ref": "#/$defs/nonempty" },
        "fontconfig": { "$ref": "#/$defs/nonempty" },
        "libfaketime_library_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "fontconfig_config_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "locale": { "const": "en_US.UTF-8" },
        "timezone": { "const": "UTC" },
        "reference_datetime": { "const": "2025-01-01T00:00:00Z" },
        "faketime_environment": {
          "const": {
            "FAKETIME": "@2025-01-01 00:00:00",
            "FAKETIME_DONT_FAKE_MONOTONIC": "1",
            "FAKETIME_NO_CACHE": "1",
            "LD_PRELOAD": "/usr/lib/x86_64-linux-gnu/faketime/libfaketime.so.1",
            "TZ": "UTC",
            "LANG": "en_US.UTF-8",
            "LC_ALL": "en_US.UTF-8"
          }
        },
        "environment_attestation_sha256": { "$ref": "#/$defs/prefixed_sha256" }
      }
    },
    "render_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "export_profile_sha256",
        "png_profile_sha256",
        "ssim_profile_sha256"
      ],
      "properties": {
        "export_profile_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "png_profile_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "ssim_profile_sha256": { "$ref": "#/$defs/prefixed_sha256" }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline",
        "execution_wrapper",
        "libreoffice_command",
        "pdftoppm_command",
        "presentation_size_emu",
        "allowed_page_counts",
        "width_px",
        "height_px",
        "color_mode",
        "dimension_mismatch",
        "pdf_page_geometry",
        "renderer_diagnostics",
        "png_encoder"
      ],
      "properties": {
        "pipeline": { "const": "pptx_to_pdf_to_poppler_png" },
        "execution_wrapper": { "const": "libfaketime_preload_all_subprocesses" },
        "libreoffice_command": {
          "const": ["libreoffice", "--headless", "-env:UserInstallation=file://<isolated-temporary-profile>", "--convert-to", "pdf", "--outdir", "/work", "/input/submission.pptx"]
        },
        "pdftoppm_command": {
          "const": ["pdftoppm", "-png", "-scale-to-x", "1920", "-scale-to-y", "1080", "/work/submission.pdf", "/work/acidslide-render"]
        },
        "presentation_size_emu": {
          "const": { "cx": 12192000, "cy": 6858000 }
        },
        "allowed_page_counts": { "const": [5, 12, 20] },
        "width_px": { "const": 1920 },
        "height_px": { "const": 1080 },
        "color_mode": { "const": "RGB" },
        "dimension_mismatch": { "const": "fail" },
        "pdf_page_geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numeric_parser", "media_box", "crop_box", "rotate"],
          "properties": {
            "numeric_parser": { "const": "exact-decimal-string" },
            "media_box": { "const": ["0", "0", "960.009448818898", "540"] },
            "crop_box": { "const": "absent-or-exactly-equal-to-media-box" },
            "rotate": { "const": "absent-or-zero" }
          }
        },
        "renderer_diagnostics": {
          "const": {
            "stdout": "informational",
            "stderr": "reject-except-exact-allowlist",
            "allowed_stderr_lines": [
              "Warning: failed to launch javaldx - java may not function correctly"
            ]
          }
        },
        "png_encoder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "format", "conversion", "optimize", "compress_level"],
          "properties": {
            "implementation": { "const": "Pillow" },
            "format": { "const": "PNG" },
            "conversion": { "const": "RGB" },
            "optimize": { "const": false },
            "compress_level": { "const": 9 }
          }
        }
      }
    },
    "visual_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "threshold",
        "dtype",
        "shape",
        "channel_axis",
        "data_range",
        "win_size",
        "gaussian_weights",
        "use_sample_covariance",
        "K1",
        "K2",
        "dimension_mismatch",
        "pixel_exact"
      ],
      "properties": {
        "algorithm": { "const": "skimage.metrics.structural_similarity" },
        "threshold": { "const": 0.9999 },
        "dtype": { "const": "uint8" },
        "shape": { "const": [1080, 1920, 3] },
        "channel_axis": { "const": 2 },
        "data_range": { "const": 255 },
        "win_size": { "const": 7 },
        "gaussian_weights": { "const": false },
        "use_sample_covariance": { "const": true },
        "K1": { "const": 0.01 },
        "K2": { "const": 0.03 },
        "dimension_mismatch": { "const": "fail-with-zero-similarity" },
        "pixel_exact": { "const": "numpy.array_equal" }
      }
    },
    "structural_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mce_profile_sha256",
        "xsd_bundle_sha256",
        "schema_root_map_sha256",
        "scene_graph_profile_sha256",
        "canonical_package_hash_profile_sha256"
      ],
      "properties": {
        "mce_profile_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "xsd_bundle_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "schema_root_map_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "scene_graph_profile_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "canonical_package_hash_profile_sha256": { "$ref": "#/$defs/prefixed_sha256" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_bundle_sha256",
        "prompt_requirements_oracle_sha256",
        "scored_assertion_inventory_sha256",
        "checklist_bundle_sha256",
        "tier_bundle_sha256",
        "asset_bundle_sha256",
        "font_bundle_sha256",
        "json_schema_bundle_sha256",
        "conformance_fixture_bundle_sha256",
        "grader_source_tree_sha256",
        "grader_source_tree_profile_sha256",
        "grader_source_tree_manifest_sha256",
        "grader_package_sha256"
      ],
      "properties": {
        "prompt_bundle_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "prompt_requirements_oracle_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "scored_assertion_inventory_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "checklist_bundle_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "tier_bundle_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "asset_bundle_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "font_bundle_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "json_schema_bundle_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "conformance_fixture_bundle_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "grader_source_tree_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "grader_source_tree_profile_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "grader_source_tree_manifest_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "grader_package_sha256": { "$ref": "#/$defs/prefixed_sha256" }
      }
    },
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_byte_sha256",
        "mce_resolved_package_sha256",
        "mce_resolved_package_size_bytes",
        "canonical_package_hash_profile_sha256",
        "canonical_package_hash_v1",
        "scene_graph_sha256",
        "canonical_pdf_sha256",
        "canonical_png_sha256s",
        "export_bundle_sha256",
        "export_determinism_evidence_sha256",
        "expected_export_count"
      ],
      "properties": {
        "original_byte_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "mce_resolved_package_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "mce_resolved_package_size_bytes": { "type": "integer", "minimum": 1 },
        "canonical_package_hash_profile_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "canonical_package_hash_v1": { "$ref": "#/$defs/prefixed_sha256" },
        "scene_graph_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "canonical_pdf_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "canonical_png_sha256s": {
          "description": "Exactly 20 canonical PNG hashes in ascending page order; array index 0 binds page 1 and index 19 binds page 20. Release validation requires byte-for-byte equality with gold-evidence canonical_export.pages in that order.",
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/prefixed_sha256" }
        },
        "export_bundle_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "export_determinism_evidence_sha256": {
          "$ref": "#/$defs/prefixed_sha256",
          "description": "SHA-256 of RFC 8785 JCS for the schema-valid 100-run export-determinism-evidence.json payload."
        },
        "expected_export_count": { "const": 20 }
      }
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1, "not": { "enum": ["unknown", "pending", "latest"] } },
    "prefixed_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
