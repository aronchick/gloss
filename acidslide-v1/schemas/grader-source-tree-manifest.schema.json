{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acidslide.dev/schemas/grader-source-tree-manifest.schema.json",
  "title": "AcidSlide Grader Source Tree Release Manifest",
  "description": "A release instance enumerates the complete source tree. grader_source_tree_sha256 is SHA-256 over RFC 8785 canonical JSON of this self-hash-free object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "source_tree_profile_sha256",
    "root",
    "entries"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "manifest_id": { "const": "acidslide-grader-source-tree-manifest-v1" },
    "source_tree_profile_sha256": { "$ref": "#/$defs/prefixed_sha256" },
    "root": { "const": "acidslide-v1/grader" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "byte_length", "sha256", "executable"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\u0000)[^/]+(?:/[^/]+)*$"
          },
          "byte_length": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/prefixed_sha256" },
          "executable": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "prefixed_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
