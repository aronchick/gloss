{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acidslide.dev/schemas/scored-assertion-inventory.schema.json",
  "title": "AcidSlide Scored Assertion Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_id",
    "lifecycle_state",
    "benchmark_version",
    "prompt_bundle_sha256",
    "reference_image_bundle_sha256",
    "asset_manifest_sha256",
    "review",
    "assertions"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "inventory_id": { "const": "acidslide-scored-assertion-inventory-v1" },
    "lifecycle_state": { "enum": ["candidate", "frozen"] },
    "benchmark_version": { "const": "acidslide-v1.0.0" },
    "prompt_bundle_sha256": { "$ref": "#/$defs/hash_or_pending" },
    "reference_image_bundle_sha256": { "$ref": "#/$defs/hash_or_pending" },
    "asset_manifest_sha256": { "$ref": "#/$defs/hash_or_pending" },
    "review": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "pending" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewer_approvals"],
          "properties": {
            "status": { "const": "approved" },
            "reviewer_approvals": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["reviewer_id", "approved_at", "inventory_sha256"],
                "properties": {
                  "reviewer_id": { "type": "string", "minLength": 1 },
                  "approved_at": { "type": "string", "format": "date-time" },
                  "inventory_sha256": {
                    "$ref": "#/$defs/prefixed_sha256",
                    "description": "Prefixed SHA-256 of RFC 8785 JCS for the domain-separated assertion-inventory review projection defined by OpenSpec 13.1.2; review is omitted."
                  }
                }
              }
            }
          }
        }
      ]
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "scored-assertion.schema.json" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "lifecycle_state": { "const": "frozen" } }, "required": ["lifecycle_state"] },
      "then": {
        "properties": {
          "prompt_bundle_sha256": { "$ref": "#/$defs/prefixed_sha256" },
          "reference_image_bundle_sha256": { "$ref": "#/$defs/prefixed_sha256" },
          "asset_manifest_sha256": { "$ref": "#/$defs/prefixed_sha256" },
          "review": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
          "assertions": {
            "items": {
              "allOf": [
                { "$ref": "scored-assertion.schema.json" },
                { "properties": { "lifecycle_state": { "const": "frozen" } } }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "assertion_evidence_index": {
      "title": "AcidSlide Assertion Evidence Index",
      "description": "The release-only fixtures/index.json is a closed, exact projection of every frozen assertion's evidence identifiers. It is not itself evidence and cannot make a candidate assertion complete.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "index_id", "assertion_inventory_review_sha256", "assertions"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "index_id": { "const": "acidslide-assertion-evidence-index-v1" },
        "assertion_inventory_review_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assertion_id", "checklist_item_id", "positive_fixture_ids", "single_fault_negative_fixture_ids", "mutation_expectation_ids"],
            "properties": {
              "assertion_id": { "$ref": "scored-assertion.schema.json#/$defs/assertion_id" },
              "checklist_item_id": { "type": "string", "pattern": "^(slide-\\d{2}|deck)\\.[a-z0-9][a-z0-9.-]*$" },
              "positive_fixture_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^fixture\\.[a-z0-9][a-z0-9._-]*$" } },
              "single_fault_negative_fixture_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^fixture\\.[a-z0-9][a-z0-9._-]*$" } },
              "mutation_expectation_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^mutation\\.[a-z0-9][a-z0-9._-]*$" } }
            }
          }
        }
      }
    },
    "prefixed_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hash_or_pending": {
      "oneOf": [
        { "$ref": "#/$defs/prefixed_sha256" },
        { "const": "pending" }
      ]
    }
  }
}
