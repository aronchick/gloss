SITE_DOMAIN=acidslide.dev
API_DOMAIN=api.acidslide.dev
TLS_EMAIL=ops@example.com
SERVICE_VERSION=1.0.0

# Generate independently; never commit the resulting .env file.
POSTGRES_PASSWORD=replace-with-32-or-more-random-characters
ADMIN_API_KEY=replace-with-32-or-more-random-characters
API_KEY_PEPPER=replace-with-32-or-more-random-characters
ENCRYPTION_KEY=replace-with-a-valid-fernet-key
METRICS_BEARER_TOKEN=replace-with-32-or-more-random-characters

GRADER_IMAGE=acidslide/grader:1.0.0
GRADER_IMAGE_DIGEST=sha256:replace-after-building-the-canonical-image
LIBREOFFICE_VERSION=replace-with-exact-build-string
FONT_BUNDLE_HASH=sha256:replace-with-canonical-font-bundle-hash
ASSET_MANIFEST_HASH=sha256:replace-with-canonical-asset-manifest-hash
ACTIVE_SCORING_MANIFEST_SHA256=sha256:replace-with-scoring-manifest-hash
ACTIVE_GRADER_SOURCE_TREE_SHA256=sha256:replace-with-grader-source-tree-hash
ACTIVE_ENVIRONMENT_ATTESTATION_SHA256=sha256:replace-with-environment-attestation-hash
ENVIRONMENT_ATTESTATION_JSON={"replace":"with-the-exact-rfc8785-hashed-environment-attestation-object"}
ACTIVE_GRADER_PACKAGE_SHA256=sha256:replace-with-grader-package-hash
ACTIVE_PROMPT_BUNDLE_SHA256=sha256:replace-with-prompt-bundle-hash
ACTIVE_SCORED_ASSERTION_INVENTORY_SHA256=sha256:replace-with-scored-assertion-inventory-hash
ACTIVE_CHECKLIST_BUNDLE_SHA256=sha256:replace-with-checklist-bundle-hash
ACTIVE_QUARANTINE_PROFILE_SHA256=sha256:replace-with-quarantine-profile-hash
ACTIVE_MCE_PROFILE_SHA256=sha256:replace-with-mce-profile-hash
ACTIVE_SCHEMA_BUNDLE_SHA256=sha256:replace-with-ecma-schema-bundle-hash
ACTIVE_SCHEMA_ROOT_MAP_SHA256=sha256:replace-with-schema-root-map-hash
ACTIVE_CANONICAL_PACKAGE_HASH_PROFILE_SHA256=sha256:replace-with-canonical-package-profile-hash
ACTIVE_GOLD_BYTE_SHA256=sha256:replace-with-gold-submission-byte-hash
ACTIVE_GOLD_MCE_RESOLVED_PACKAGE_SHA256=sha256:replace-with-gold-resolved-package-byte-hash
ACTIVE_GOLD_CANONICAL_PACKAGE_SHA256=sha256:replace-with-gold-canonical-package-hash

# Distinct maintainer public keys authorize single-use release and drift controls.
# Never reuse the quarantine verdict keyring for these authorizations.
CONTROL_VERIFICATION_KEYS_JSON={"maintainer-2026-01":{"public_key":"replace-with-base64-raw-ed25519-public-key","purposes":["release_reference","drift_canary"],"not_before":"2026-01-01T00:00:00Z","not_after":"2027-01-01T00:00:00Z","revoked_at":null}}
DRIFT_CANARY_MAX_AGE_SECONDS=691200

# Generate a distinct Ed25519 key. The API receives only the public keyring;
# Compose injects the private key only into the quarantine dispatcher.
QUARANTINE_IMAGE=acidslide/quarantine:1.0.0
QUARANTINE_IMAGE_DIGEST=sha256:replace-after-building-the-quarantine-image
QUARANTINE_SIGNING_KEY_ID=quarantine-2026-01
QUARANTINE_SIGNING_PRIVATE_KEY=replace-with-base64-raw-ed25519-private-key
QUARANTINE_VERIFICATION_KEYS_JSON={"quarantine-2026-01":{"public_key":"replace-with-base64-raw-ed25519-public-key","not_before":"2026-01-01T00:00:00Z","not_after":"2027-01-01T00:00:00Z","revoked_at":null}}
DOCKER_GID=999
