**/.ruff_cache/
**/.venv/
**/__pycache__/
**/*.py[cod]
grader/build/
grader/dist/
service/

# Release identities bind the OCI digest and therefore cannot be inputs to the
# environment image whose digest they name. The signed release package is a
# separate read-only runtime mount selected by GLOSS_BENCHMARK_DIR.
benchmark/environment-attestation.json
benchmark/export-determinism-evidence.json
benchmark/gold-evidence.json
benchmark/runtime-freeze.json
benchmark/scoring-manifest.json
benchmark/release-index.json
benchmark/release-index-chain.json
benchmark/baselines/*.json
benchmark/control-handoffs/*.json

# Comparative decks and local self-reported grading outputs are mounted inputs,
# never part of the renderer image they identify.
benchmark/comparative-v1/
