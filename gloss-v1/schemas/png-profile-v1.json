{
  "schema_version": "1.0",
  "profile_id": "gloss-png-profile-v1",
  "rasterizer": "poppler-pdftoppm",
  "pdftoppm_command": [
    "pdftoppm",
    "-png",
    "-scale-to-x",
    "1920",
    "-scale-to-y",
    "1080",
    "/work/submission.pdf",
    "/work/gloss-render"
  ],
  "width_px": 1920,
  "height_px": 1080,
  "color_mode": "RGB",
  "page_naming": "slide-%02d.png",
  "encoder": {
    "implementation": "Pillow",
    "format": "PNG",
    "conversion": "RGB",
    "optimize": false,
    "compress_level": 9
  }
}
