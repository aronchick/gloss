{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gloss.dev/schemas/scored-assertion.schema.json",
  "title": "Gloss Scored Assertion",
  "description": "Atomic prompt/reference-image/asset-manifest requirement. Gold OOXML is never an allowed provenance source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lifecycle_state",
    "assertion_id",
    "checklist_item_id",
    "scope",
    "tier",
    "statement",
    "provenance",
    "property_class",
    "source_of_truth",
    "verification_method",
    "expected_observation",
    "evidence",
    "gold_ooxml_is_oracle"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "lifecycle_state": { "enum": ["candidate", "frozen"] },
    "assertion_id": { "$ref": "#/$defs/assertion_id" },
    "checklist_item_id": {
      "type": "string",
      "pattern": "^(slide-\\d{2}|deck)\\.[a-z0-9][a-z0-9.-]*$"
    },
    "scope": { "enum": ["slide", "deck"] },
    "slide": { "type": "integer", "minimum": 1, "maximum": 20 },
    "tier": { "type": "integer", "enum": [1, 2, 3] },
    "statement": { "type": "string", "minLength": 1 },
    "provenance": { "$ref": "#/$defs/provenance" },
    "property_class": {
      "enum": [
        "native_structure",
        "editability",
        "master",
        "layout",
        "theme",
        "field",
        "chart",
        "table",
        "text_content",
        "visual_appearance",
        "visual_geometry",
        "visual_color",
        "visual_typography",
        "visual_spacing",
        "asset_identity",
        "asset_license",
        "asset_usage",
        "asset_hash",
        "asset_dimensions"
      ]
    },
    "source_of_truth": { "enum": ["ooxml", "render", "both"] },
    "verification_method": {
      "enum": [
        "object_compare",
        "text_match",
        "field_check",
        "layout_check",
        "visual_ssim",
        "pixel_region_compare",
        "manifest_lookup",
      "embedded_media_hash",
      "embedded_media_dimensions",
      "anti_cheat"
      ]
    },
    "expected_observation": {
      "type": "object",
      "minProperties": 1,
      "description": "Assertion expectation expressed without deriving a new requirement from gold OOXML."
    },
    "evidence": { "$ref": "#/$defs/evidence" },
    "gold_ooxml_is_oracle": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "scope": { "const": "slide" } }, "required": ["scope"] },
      "then": { "required": ["slide"] },
      "else": { "not": { "required": ["slide"] } }
    },
    {
      "if": { "properties": { "lifecycle_state": { "const": "frozen" } }, "required": ["lifecycle_state"] },
      "then": {
        "properties": {
          "provenance": { "$ref": "#/$defs/complete_provenance" },
          "evidence": { "$ref": "#/$defs/complete_evidence" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": { "properties": { "kind": { "const": "reference_image" } }, "required": ["kind"] }
        },
        "required": ["provenance"]
      },
      "then": {
        "properties": {
          "property_class": {
            "enum": ["visual_appearance", "visual_geometry", "visual_color", "visual_typography", "visual_spacing"]
          },
          "source_of_truth": { "const": "render" },
          "verification_method": { "enum": ["visual_ssim", "pixel_region_compare"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": { "properties": { "kind": { "const": "asset_manifest" } }, "required": ["kind"] }
        },
        "required": ["provenance"]
      },
      "then": {
        "properties": {
          "property_class": { "enum": ["asset_identity", "asset_license", "asset_usage", "asset_hash", "asset_dimensions"] },
          "source_of_truth": { "const": "ooxml" },
          "verification_method": { "enum": ["manifest_lookup", "embedded_media_hash", "embedded_media_dimensions"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "property_class": {
            "enum": ["native_structure", "editability", "master", "layout", "theme", "field", "chart", "table"]
          },
          "provenance": { "properties": { "status": { "const": "complete" } }, "required": ["status"] }
        },
        "required": ["property_class", "provenance"]
      },
      "then": {
        "properties": {
          "provenance": { "properties": { "kind": { "const": "prompt" } }, "required": ["kind"] }
        }
      }
    }
  ],
  "$defs": {
    "prefixed_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "assertion_id": {
      "type": "string",
      "pattern": "^(slide-\\d{2}|deck)\\.assert-[a-z0-9][a-z0-9.-]*$"
    },
    "complete_provenance": {
      "$ref": "#/$defs/provenance_complete_shape"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "complete"] },
        "reason": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["prompt", "reference_image", "asset_manifest"] },
        "source_hash": { "$ref": "#/$defs/prefixed_sha256" },
        "locator": { "type": "string", "minLength": 1 },
    "prompt_requirement_id": {
      "type": "string",
      "pattern": "^(slide-\\d{2}|deck)\\.prompt-r\\d{3}$"
    },
        "slide": { "type": "integer", "minimum": 1, "maximum": 20 },
        "region": { "$ref": "#/$defs/reference_region" },
        "asset_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pending" } }, "required": ["status"] },
          "then": {
            "required": ["reason"],
            "not": { "anyOf": [{ "required": ["kind"] }, { "required": ["source_hash"] }] }
          },
          "else": { "$ref": "#/$defs/provenance_complete_requirements" }
        }
      ]
    },
    "provenance_complete_shape": {
      "allOf": [
        { "$ref": "#/$defs/provenance" },
        { "properties": { "status": { "const": "complete" } }, "required": ["status"] }
      ]
    },
    "provenance_complete_requirements": {
      "required": ["kind", "source_hash"],
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "prompt" } }, "required": ["kind"] },
          "then": { "required": ["locator", "prompt_requirement_id"] }
        },
        {
          "if": { "properties": { "kind": { "const": "reference_image" } }, "required": ["kind"] },
          "then": { "required": ["slide", "region"] }
        },
        {
          "if": { "properties": { "kind": { "const": "asset_manifest" } }, "required": ["kind"] },
          "then": { "required": ["asset_id"] }
        }
      ]
    },
    "reference_region": {
      "$comment": "The semantic validator additionally requires x + width <= 1920 and y + height <= 1080.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "units"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 1919 },
        "y": { "type": "integer", "minimum": 0, "maximum": 1079 },
        "width": { "type": "integer", "minimum": 1, "maximum": 1920 },
        "height": { "type": "integer", "minimum": 1, "maximum": 1080 },
        "units": { "const": "pixels_at_1920x1080" }
      }
    },
    "pending_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "pending" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "complete_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "positive_fixture_ids", "single_fault_negative_fixture_ids", "mutation_expectation_ids"],
      "properties": {
        "status": { "const": "complete" },
        "positive_fixture_ids": { "$ref": "#/$defs/nonempty_fixture_ids" },
        "single_fault_negative_fixture_ids": { "$ref": "#/$defs/nonempty_fixture_ids" },
        "mutation_expectation_ids": { "$ref": "#/$defs/nonempty_mutation_ids" }
      }
    },
    "evidence": {
      "oneOf": [
        { "$ref": "#/$defs/pending_evidence" },
        { "$ref": "#/$defs/complete_evidence" }
      ]
    },
    "nonempty_fixture_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^fixture\\.[a-z0-9][a-z0-9._-]*$" }
    },
    "nonempty_mutation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^mutation\\.[a-z0-9][a-z0-9._-]*$" }
    }
  }
}
