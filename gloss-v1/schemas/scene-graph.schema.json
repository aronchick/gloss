{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gloss.dev/schemas/scene-graph.schema.json",
  "title": "Gloss Normalized Presentation Scene Graph",
  "description": "Deterministic structural extraction from one MCE-resolved package. It is evidence/control data and never an independent scored-requirement source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_sha256", "mce_resolved_package_sha256", "units", "slide_size", "slides", "gold_ooxml_is_oracle"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_sha256": { "$ref": "#/$defs/hash" },
    "mce_resolved_package_sha256": { "$ref": "#/$defs/hash" },
    "units": { "const": "EMU" },
    "slide_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slide", "part_name", "layout_part", "master_part", "nodes", "relationships"],
        "properties": {
          "slide": { "type": "integer", "minimum": 1, "maximum": 20 },
          "part_name": { "$ref": "#/$defs/part_name" },
          "layout_part": { "$ref": "#/$defs/part_name" },
          "master_part": { "$ref": "#/$defs/part_name" },
          "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
          "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } }
        }
      }
    },
    "gold_ooxml_is_oracle": { "const": false }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "part_name": { "type": "string", "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+$" },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind", "source_part", "source_locator", "z_index", "bbox", "rotation_degrees", "hidden", "text_runs", "native_properties", "children"],
      "properties": {
        "node_id": { "$ref": "#/$defs/node_id" },
        "kind": { "enum": ["shape", "text", "picture", "chart", "table", "group", "connector", "field", "placeholder", "graphic_frame"] },
        "source_part": { "$ref": "#/$defs/part_name" },
        "source_locator": { "type": "string", "minLength": 1 },
        "z_index": { "type": "integer", "minimum": 0 },
        "bbox": { "$ref": "#/$defs/bbox" },
        "rotation_degrees": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
        "hidden": { "type": "boolean" },
        "text_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "language", "rtl", "font_family", "font_size_pt", "bold", "italic"],
            "properties": {
              "text": { "type": "string" },
              "language": { "type": ["string", "null"] },
              "rtl": { "type": "boolean" },
              "font_family": { "type": ["string", "null"] },
              "font_size_pt": { "type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
              "bold": { "type": ["boolean", "null"] },
              "italic": { "type": ["boolean", "null"] }
            }
          }
        },
        "asset_sha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "native_properties": { "$ref": "#/$defs/native_properties" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    },
    "node_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,255}$" },
    "native_properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_xml_kind",
        "subtype",
        "parent_group_path",
        "name",
        "placeholder_type",
        "placeholder_index",
        "table_dimensions",
        "chart_type",
        "chart_data_summary",
        "field_type",
        "field_types",
        "paragraph_properties",
        "fill",
        "stroke",
        "opacity",
        "shadow",
        "crop",
        "crop_to_shape",
        "hyperlink_targets"
      ],
      "properties": {
        "source_xml_kind": { "enum": ["sp", "pic", "graphicFrame", "grpSp", "cxnSp"] },
        "subtype": { "type": ["string", "null"] },
        "parent_group_path": {
          "type": "array",
          "items": { "$ref": "#/$defs/node_id" }
        },
        "name": { "type": "string" },
        "placeholder_type": { "type": ["string", "null"] },
        "placeholder_index": { "type": ["integer", "null"], "minimum": 0 },
        "table_dimensions": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["rows", "columns"],
              "properties": {
                "rows": { "type": "integer", "minimum": 0 },
                "columns": { "type": "integer", "minimum": 0 }
              }
            },
            { "type": "null" }
          ]
        },
        "chart_type": { "type": ["string", "null"] },
        "chart_data_summary": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["series_count", "category_point_count", "value_point_count"],
              "properties": {
                "series_count": { "type": "integer", "minimum": 0 },
                "category_point_count": { "type": "integer", "minimum": 0 },
                "value_point_count": { "type": "integer", "minimum": 0 }
              }
            },
            { "type": "null" }
          ]
        },
        "field_type": { "type": ["string", "null"] },
        "field_types": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "paragraph_properties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "rtl", "alignment", "margin_left", "indent", "tab_stops", "bullet", "line_spacing"],
            "properties": {
              "level": { "type": ["integer", "null"], "minimum": 0 },
              "rtl": { "type": "boolean" },
              "alignment": { "type": ["string", "null"] },
              "margin_left": { "type": ["integer", "null"] },
              "indent": { "type": ["integer", "null"] },
              "tab_stops": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["position", "alignment"],
                  "properties": {
                    "position": { "type": "integer" },
                    "alignment": { "type": ["string", "null"] }
                  }
                }
              },
              "bullet": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "value"],
                    "properties": {
                      "kind": { "enum": ["buNone", "buChar", "buAutoNum", "buBlip"] },
                      "value": { "type": ["string", "null"] }
                    }
                  },
                  { "type": "null" }
                ]
              },
              "line_spacing": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "value"],
                    "properties": {
                      "kind": { "enum": ["spcPct", "spcPts"] },
                      "value": { "type": ["integer", "null"] }
                    }
                  },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        "fill": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "color", "alpha"],
          "properties": {
            "kind": { "enum": ["inherited", "solidFill", "gradFill", "pattFill", "noFill", "blipFill"] },
            "color": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "value"],
                  "properties": {
                    "kind": { "type": "string", "minLength": 1 },
                    "value": { "type": ["string", "null"] }
                  }
                },
                { "type": "null" }
              ]
            },
            "alpha": { "type": ["string", "null"], "pattern": "^[0-9]+$" }
          }
        },
        "stroke": {
          "type": "object",
          "additionalProperties": false,
          "required": ["present", "width_emu", "dash"],
          "properties": {
            "present": { "type": "boolean" },
            "width_emu": { "type": ["integer", "null"], "minimum": 0 },
            "dash": { "type": ["string", "null"] }
          }
        },
        "opacity": { "type": "string", "pattern": "^(0|1|0\\.[0-9]+)$" },
        "shadow": { "type": "boolean" },
        "crop": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["l", "t", "r", "b"],
              "properties": {
                "l": { "type": "integer" },
                "t": { "type": "integer" },
                "r": { "type": "integer" },
                "b": { "type": "integer" }
              }
            },
            { "type": "null" }
          ]
        },
        "crop_to_shape": { "type": "boolean" },
        "hyperlink_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/part_name" }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "target_mode", "target"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "format": "uri" },
        "target_mode": { "enum": ["Internal", "External"] },
        "target": { "type": "string", "minLength": 1 }
      }
    }
  }
}
