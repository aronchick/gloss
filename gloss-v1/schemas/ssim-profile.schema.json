{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gloss.dev/schemas/ssim-profile.schema.json",
  "title": "Gloss v1 SSIM Comparison Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "algorithm",
    "threshold",
    "dtype",
    "shape",
    "channel_axis",
    "data_range",
    "win_size",
    "gaussian_weights",
    "use_sample_covariance",
    "K1",
    "K2",
    "dimension_mismatch",
    "pixel_exact"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_id": { "const": "gloss-ssim-profile-v1" },
    "algorithm": { "const": "skimage.metrics.structural_similarity" },
    "threshold": { "const": 0.9999 },
    "dtype": { "const": "uint8" },
    "shape": { "const": [1080, 1920, 3] },
    "channel_axis": { "const": 2 },
    "data_range": { "const": 255 },
    "win_size": { "const": 7 },
    "gaussian_weights": { "const": false },
    "use_sample_covariance": { "const": true },
    "K1": { "const": 0.01 },
    "K2": { "const": 0.03 },
    "dimension_mismatch": { "const": "fail-with-zero-similarity" },
    "pixel_exact": { "const": "numpy.array_equal" }
  }
}
