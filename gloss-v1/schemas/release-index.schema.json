{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gloss.dev/schemas/release-index.schema.json",
  "title": "Gloss Signed Release Index",
  "$comment": "The chain validator additionally requires effective_at >= issued_at, exact +1 sequence continuity, previous hash equality, forward-only state, and persistent highest-valid-chain-head acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "benchmark_version",
    "channel",
    "issued_at",
    "effective_at",
    "sequence",
    "previous_release_index_sha256",
    "acceptance_policy",
    "state",
    "scoring_manifest_sha256",
    "cohort_descriptor",
    "scoring_cohort_id",
    "signatures"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "release_id": { "const": "gloss-v1.0.0" },
    "benchmark_version": { "const": "gloss-v1.0.0" },
    "channel": { "const": "gloss-v1-stable" },
    "issued_at": { "type": "string", "format": "date-time" },
    "effective_at": { "type": "string", "format": "date-time" },
    "sequence": { "type": "integer", "minimum": 1 },
    "previous_release_index_sha256": {
      "oneOf": [
        { "$ref": "#/$defs/prefixed_sha256" },
        { "type": "null" }
      ]
    },
    "acceptance_policy": { "const": "highest_valid_chain_head" },
    "state": { "enum": ["active", "frozen", "superseded"] },
    "scoring_manifest_sha256": { "$ref": "#/$defs/prefixed_sha256" },
    "cohort_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scoring_manifest_sha256",
        "grader_source_tree_sha256",
        "environment_attestation_sha256"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "scoring_manifest_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "grader_source_tree_sha256": { "$ref": "#/$defs/prefixed_sha256" },
        "environment_attestation_sha256": { "$ref": "#/$defs/prefixed_sha256" }
      }
    },
    "scoring_cohort_id": { "$ref": "#/$defs/prefixed_sha256" },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["algorithm", "key_id", "signature_base64"],
        "properties": {
          "algorithm": { "const": "Ed25519" },
          "key_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
          "signature_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "sequence": { "const": 1 } },
        "required": ["sequence"]
      },
      "then": { "properties": { "previous_release_index_sha256": { "type": "null" } } },
      "else": {
        "properties": {
          "previous_release_index_sha256": { "$ref": "#/$defs/prefixed_sha256" }
        }
      }
    }
  ],
  "$defs": {
    "prefixed_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
