{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gloss.dev/schemas/grader-source-tree-profile.schema.json",
  "title": "Gloss Grader Source Tree Construction Profile",
  "description": "Algorithm/configuration only. A release inventory is a separate grader-source-tree-manifest.schema.json instance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "root",
    "manifest_canonicalization",
    "manifest_digest",
    "path_normalization",
    "path_order",
    "entry_content",
    "collision_policy",
    "filesystem_entry_policy",
    "inventory_policy"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_id": { "const": "gloss-grader-source-tree-v1" },
    "root": { "const": "gloss-v1/grader" },
    "manifest_canonicalization": { "const": "RFC8785-JCS" },
    "manifest_digest": { "const": "SHA-256-lowercase-hex-prefixed" },
    "path_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "unicode", "separator", "reject_absolute", "reject_empty_segment", "reject_dot_segments", "reject_backslash", "reject_nul"],
      "properties": {
        "encoding": { "const": "UTF-8" },
        "unicode": { "const": "NFC" },
        "separator": { "const": "/" },
        "reject_absolute": { "const": true },
        "reject_empty_segment": { "const": true },
        "reject_dot_segments": { "const": true },
        "reject_backslash": { "const": true },
        "reject_nul": { "const": true }
      }
    },
    "path_order": { "const": "ascending-Unicode-code-point" },
    "entry_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_length", "sha256", "executable"],
      "properties": {
        "byte_length": { "const": "exact-file-byte-length" },
        "sha256": { "const": "SHA-256-of-exact-file-bytes" },
        "executable": { "const": "any-POSIX-execute-bit-set" }
      }
    },
    "collision_policy": {
      "const": {
        "duplicate_path": "reject",
        "case_fold_collision": "reject"
      }
    },
    "filesystem_entry_policy": {
      "const": {
        "regular_file": "enumerate",
        "symlink": "reject",
        "hard_link": "reject",
        "directory": "traverse",
        "device": "reject",
        "socket": "reject",
        "fifo": "reject"
      }
    },
    "inventory_policy": {
      "const": {
        "implicit_ignores": false,
        "extra_entry": "reject",
        "missing_entry": "reject"
      }
    }
  }
}
