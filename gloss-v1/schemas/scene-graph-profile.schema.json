{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gloss.dev/schemas/scene-graph-profile.schema.json",
  "title": "Gloss Normalized Scene Graph Extraction Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "input_contract",
    "slide_order",
    "relationship_normalization",
    "node_normalization",
    "text_normalization",
    "numeric_normalization",
    "serialization"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_id": { "const": "gloss-scene-graph-profile-v1" },
    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_state",
        "allowed_slide_counts",
        "mce_namespace_policy",
        "external_relationship_policy",
        "dangling_relationship_policy",
        "missing_layout_or_master_policy"
      ],
      "properties": {
        "package_state": { "const": "mce-resolved" },
        "allowed_slide_counts": { "const": [5, 12, 20] },
        "mce_namespace_policy": { "const": "reject-elements-and-attributes" },
        "external_relationship_policy": { "const": "reject" },
        "dangling_relationship_policy": { "const": "reject" },
        "missing_layout_or_master_policy": { "const": "reject" }
      }
    },
    "slide_order": {
      "const": {
        "source_part": "/ppt/presentation.xml",
        "id_path": "/p:presentation/p:sldIdLst/p:sldId/@r:id",
        "relationship_part": "/ppt/_rels/presentation.xml.rels"
      }
    },
    "relationship_normalization": {
      "const": {
        "internal_target_form": "absolute-opc-part-name",
        "external_target_form": "prohibited",
        "order": "relationship-id-unicode-codepoint",
        "duplicate_id_policy": "reject"
      }
    },
    "node_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_order",
        "node_id",
        "ignored_identifiers",
        "bbox_coordinate_space",
        "kind_precedence"
      ],
      "properties": {
        "source_order": { "const": "shape-tree-document-order" },
        "node_id": { "const": "slide-number-and-zero-based-structural-index-path" },
        "ignored_identifiers": { "const": ["p:cNvPr/@id", "p:cNvPr/@name"] },
        "bbox_coordinate_space": { "const": "owning-shape-tree-emu" },
        "kind_precedence": {
          "const": [
            "group",
            "connector",
            "table",
            "chart",
            "picture",
            "placeholder",
            "field",
            "text",
            "shape",
            "graphic_frame"
          ]
        }
      }
    },
    "text_normalization": {
      "const": {
        "run_sources": ["a:r", "a:fld", "a:br"],
        "break_text": "\n",
        "font_resolution": "direct-run-properties-only",
        "missing_boolean": null,
        "missing_language_or_font": null
      }
    },
    "numeric_normalization": {
      "const": {
        "geometry_unit": "EMU",
        "rotation_source_unit": "60000th-degree",
        "rotation_output": "exact-decimal-no-trailing-zero",
        "font_size_source_unit": "100th-point",
        "font_size_output": "exact-decimal-no-trailing-zero",
        "opacity_source_unit": "100000th",
        "opacity_output": "exact-decimal-no-trailing-zero"
      }
    },
    "serialization": {
      "const": {
        "canonicalization": "RFC8785-JCS",
        "deck_fixture": "expected-deck.json",
        "slide_fixture_pattern": "expected-scenegraphs/slide-%02d.json",
        "slide_order": "ascending-slide-number",
        "node_order": "z-index",
        "relationship_order": "relationship-id-unicode-codepoint"
      }
    }
  }
}
