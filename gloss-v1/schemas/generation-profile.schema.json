{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gloss.dev/schemas/generation-profile.schema.json",
  "title": "Gloss Immutable Generation Profile",
  "description": "Self-hash-free RFC 8785 payload used to derive generation_profile_sha256. It deliberately contains no artifact identity, result, run seed, or timestamp.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "canonicalization",
    "generator",
    "generation_strategy",
    "toolchain",
    "sampling",
    "permissions"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_id": { "const": "gloss-generation-profile-v1" },
    "canonicalization": { "const": "RFC8785-JCS" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_identifier", "immutable_revision", "api_surface"],
      "properties": {
        "provider": { "$ref": "#/$defs/nonempty" },
        "model_identifier": { "$ref": "#/$defs/nonempty" },
        "immutable_revision": { "$ref": "#/$defs/nonempty" },
        "api_surface": { "$ref": "#/$defs/nonempty" }
      }
    },
    "generation_strategy": { "enum": ["direct", "code", "hybrid", "template-edit"] },
    "toolchain": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "immutable_version", "artifact_sha256"],
        "properties": {
          "name": { "$ref": "#/$defs/nonempty" },
          "immutable_version": { "$ref": "#/$defs/nonempty" },
          "artifact_sha256": {
            "oneOf": [
              { "$ref": "#/$defs/prefixed_sha256" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "top_p", "top_k", "max_output_tokens", "other_parameters"],
      "properties": {
        "temperature": { "$ref": "#/$defs/nonnegative_number_or_null" },
        "top_p": {
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "top_k": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "max_output_tokens": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "other_parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "canonical_json_value"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$" },
              "canonical_json_value": {}
            }
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_intervention_permitted", "post_processing_permitted"],
      "properties": {
        "human_intervention_permitted": { "type": "boolean" },
        "post_processing_permitted": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "not": { "enum": ["unknown", "pending", "latest"] }
    },
    "prefixed_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonnegative_number_or_null": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "null" }
      ]
    }
  }
}
